---
import Layout from "./Layout.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;

const ruta = Astro.url.pathname;
const enlaces = [
  {
    href: "/",
    label: "Inicio",
    exacto: true,
    icono:
      '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  },
  {
    href: "/reservas",
    label: "Reservas",
    exacto: false,
    icono:
      '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/>',
  },
  {
    href: "/clientes",
    label: "Clientes",
    exacto: false,
    icono:
      '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  },
];
const activo = (e: (typeof enlaces)[number]) =>
  e.exacto ? ruta === e.href : ruta.startsWith(e.href);
---

<Layout title={title}>
  <p id="app-cargando" class="estado">Cargando…</p>

  <div id="app-error" class="estado" role="alert" hidden>
    <p>No se pudo conectar con el servidor.</p>
    <p class="estado__detalle" id="app-error-url"></p>
    <button id="app-reintentar" type="button">Reintentar</button>
  </div>

  <div id="app" class="shell" hidden>
    <header class="nav">
      <a class="nav__marca" href="/">
        <span class="nav__nombre">Luxury Transfers</span>
        <span class="nav__sub">Riviera · CRM</span>
      </a>

      <nav class="nav__links" aria-label="Principal">
        {
          enlaces.map((e) => (
            <a
              class="nav__link"
              href={e.href}
              aria-current={activo(e) ? "page" : undefined}
            >
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={e.icono}
              />
              <span>{e.label}</span>
            </a>
          ))
        }
      </nav>

      <div class="nav__pie">
        <div class="nav__herramientas">
          <button
            id="btn-tema"
            class="icono-btn"
            type="button"
            title="Cambiar entre modo claro y oscuro"
            aria-label="Cambiar entre modo claro y oscuro"
          >
            <svg
              class="i-sol"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path></svg
            >
            <svg
              class="i-luna"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
              ></path></svg
            >
          </button>
          <button
            id="btn-menu"
            class="icono-btn"
            type="button"
            title="Mover el menú: arriba o al lateral"
            aria-label="Mover el menú: arriba o al lateral"
          >
            <svg
              class="i-lateral"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><rect x="3" y="4" width="18" height="16" rx="2"></rect><path
                d="M9 4v16"></path></svg
            >
            <svg
              class="i-superior"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><rect x="3" y="4" width="18" height="16" rx="2"></rect><path
                d="M3 9h18"></path></svg
            >
          </button>
        </div>

        <div class="nav__usuario">
          <span id="user-name" class="nav__nombre-usuario"></span>
          <button id="logout-btn" class="nav__salir" type="button"
            >Cerrar sesión</button
          >
        </div>
      </div>
    </header>

    <main class="main">
      <div class="content">
        <slot />
      </div>
    </main>
  </div>
</Layout>

<style>
  /* ── Estados previos a mostrar la app ── */
  .estado {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    text-align: center;
    padding: 24px;
  }

  .estado p {
    margin: 0;
  }

  .estado__detalle {
    font-size: 0.8rem;
    word-break: break-all;
  }

  .estado button {
    margin-top: 12px;
    background: var(--accent);
    color: var(--on-accent);
    border: none;
    border-radius: var(--radius);
    padding: 8px 18px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .estado button:hover {
    background: var(--accent-hover);
  }

  /* ── Estructura: menú arriba (por defecto) ── */
  .shell {
    min-height: 100vh;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    min-height: 56px;
    padding: 8px 24px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .nav__marca {
    display: flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    color: var(--text);
  }

  .nav__nombre {
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: 1.05rem;
  }

  .nav__sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .nav__links {
    display: flex;
    gap: 4px;
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: var(--radius);
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .nav__link:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav__link[aria-current="page"] {
    color: var(--text);
    background: var(--surface-2);
    font-weight: 500;
  }

  .nav__pie {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav__herramientas {
    display: flex;
    gap: 2px;
  }

  .icono-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    border-radius: var(--radius);
    color: var(--text-muted);
    cursor: pointer;
  }

  .icono-btn:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav__usuario {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .nav__salir {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: var(--radius);
    padding: 5px 12px;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .nav__salir:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .content {
    padding: 32px 24px 56px;
    max-width: 1120px;
    margin: 0 auto;
  }

  /* Íconos: cada botón muestra el estado al que cambiaría */
  :global(html[data-theme="dark"]) .i-luna,
  :global(html[data-theme="light"]) .i-sol,
  :global(html[data-nav="top"]) .i-superior,
  :global(html[data-nav="side"]) .i-lateral {
    display: none;
  }

  /* ── Menú lateral (solo en pantallas anchas; en móvil siempre va arriba) ── */
  @media (min-width: 861px) {
    :global(html[data-nav="side"]) .shell {
      display: grid;
      grid-template-columns: 232px minmax(0, 1fr);
    }

    :global(html[data-nav="side"]) .nav {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 24px;
      height: 100vh;
      padding: 20px 12px;
      border-bottom: none;
      border-right: 1px solid var(--border);
    }

    :global(html[data-nav="side"]) .nav__marca {
      flex-direction: column;
      gap: 0;
      padding: 0 10px;
    }

    :global(html[data-nav="side"]) .nav__links {
      flex-direction: column;
    }

    :global(html[data-nav="side"]) .nav__pie {
      margin: auto 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    :global(html[data-nav="side"]) .nav__herramientas {
      padding: 0 4px;
    }

    :global(html[data-nav="side"]) .nav__usuario {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding: 12px 10px 0;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 860px) {
    .nav {
      padding: 8px 16px;
      gap: 8px 16px;
    }

    .nav__sub,
    .nav__nombre-usuario {
      display: none;
    }

    .content {
      padding: 24px 16px 48px;
    }
  }
</style>

<script>
  import { API_URL } from "../lib/api";

  const raiz = document.documentElement;
  const app = document.querySelector<HTMLDivElement>("#app")!;
  const cargando =
    document.querySelector<HTMLParagraphElement>("#app-cargando")!;
  const errorEl = document.querySelector<HTMLDivElement>("#app-error")!;
  const errorUrl =
    document.querySelector<HTMLParagraphElement>("#app-error-url")!;
  const userNameEl = document.querySelector<HTMLSpanElement>("#user-name")!;

  // ── Tema y posición del menú (se recuerdan en este navegador) ──
  function guardar(clave: string, valor: string) {
    try {
      localStorage.setItem(clave, valor);
    } catch {
      /* sin almacenamiento: el cambio vale solo para esta visita */
    }
  }

  document.querySelector("#btn-tema")!.addEventListener("click", () => {
    const siguiente = raiz.dataset.theme === "dark" ? "light" : "dark";
    raiz.dataset.theme = siguiente;
    guardar("crm-theme", siguiente);
  });

  document.querySelector("#btn-menu")!.addEventListener("click", () => {
    const siguiente = raiz.dataset.nav === "side" ? "top" : "side";
    raiz.dataset.nav = siguiente;
    guardar("crm-nav", siguiente);
  });

  // ── Sesión ──
  async function iniciar() {
    errorEl.hidden = true;
    cargando.hidden = false;
    try {
      const res = await fetch(`${API_URL}/auth/me`, { credentials: "include" });

      if (res.status === 401) {
        window.location.href = "/login";
        return;
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const { usuario } = await res.json();
      userNameEl.textContent = usuario.nombre;
      cargando.hidden = true;
      app.hidden = false;

      // Las páginas hijas esperan esto antes de pedir sus propios datos.
      document.dispatchEvent(
        new CustomEvent("auth-ready", { detail: { usuario } }),
      );
    } catch {
      cargando.hidden = true;
      app.hidden = true;
      errorUrl.textContent = API_URL;
      errorEl.hidden = false;
    }
  }

  document.querySelector("#app-reintentar")!.addEventListener("click", iniciar);

  document.querySelector("#logout-btn")!.addEventListener("click", async () => {
    await fetch(`${API_URL}/auth/logout`, {
      method: "POST",
      credentials: "include",
    }).catch(() => null);
    window.location.href = "/login";
  });

  iniciar();
</script>
